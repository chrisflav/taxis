<?xml version="1.0" encoding="utf-8"?>
<!--
  The taxis turnstile: the same mark as the favicon (`frontend/public/icon.svg`) and the wordmark in
  the top bar — two bars at one weight, all straight edges and round caps.

  A vector rather than the five PNG densities a launcher icon usually ships as, which is what
  `minSdkVersion 26` buys: adaptive icons arrived in Android 8, so from that floor up the launcher
  masks this itself and no density needs its own bitmap.

  The glyph is drawn in the icon.svg coordinate system and placed by the group transform, so the two
  files stay comparable. The result sits inside the inner 72dp of the 108dp canvas — everything
  outside that is what a launcher is free to crop into a circle, a squircle or a rounded square.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:translateX="10.8"
        android:translateY="10.8"
        android:scaleX="2.7"
        android:scaleY="2.7">
        <!-- The upright, 3.6 wide from y=7.5 to y=24.5, capped by half-width arcs. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M11.8,7.5 a1.8,1.8 0 0,1 1.8,1.8 v13.4 a1.8,1.8 0 0,1 -3.6,0 v-13.4 a1.8,1.8 0 0,1 1.8,-1.8 z" />
        <!-- The arm, 3.6 tall from x=10 to x=22, crossing the upright. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M11.8,14.2 h8.4 a1.8,1.8 0 0,1 0,3.6 h-8.4 a1.8,1.8 0 0,1 0,-3.6 z" />
    </group>
</vector>
