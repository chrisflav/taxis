<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ replaces `allowBackup`/`fullBackupContent` with these two, and a missing rules file
     means "back everything up". The app's only stored state is the server it is connected to and
     the token it connects with, so both channels are turned off outright. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
